<Window x:Class="FolderThemeStudio.App.FolderCategoryPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Folder category"
        Width="310"
        SizeToContent="Height"
        MinHeight="96"
        MaxWidth="360"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Focusable="False"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True">
    <Border x:Name="CardPanel" Margin="8" Padding="16" Background="White" BorderBrush="#DDE4EE" BorderThickness="1"
            CornerRadius="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="5" Opacity="0.18" Color="#25334B" />
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border x:Name="CategoryAccent" Grid.RowSpan="2" CornerRadius="3" Background="#2868D7" />
            <StackPanel Grid.Column="2">
                <TextBlock x:Name="CategoryTitle" FontSize="15" FontWeight="SemiBold" Foreground="#172033"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="CategoryNote" Margin="0,5,0,0" Foreground="#58647A" TextWrapping="Wrap"
                           MaxWidth="290" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
